# LLM provider (OpenAI-compatible API). Defaults to Groq's free tier.
# Get a free API key at https://console.groq.com
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Strong free models on Groq with reliable tool calling:
#   qwen/qwen3.6-27b     (recommended: reliable tool calling + great Arabic)
#   openai/gpt-oss-120b  (best quality, but easy to hit the 8k TPM free-tier cap)
#   llama-3.3-70b-versatile (flaky tool parsing - avoid)
LLM_MODEL=qwen/qwen3.6-27b

# Optional: Tavily search API key (free tier: https://tavily.com).
# If empty, the app uses free DuckDuckGo search instead.
TAVILY_API_KEY=
